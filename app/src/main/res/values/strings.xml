    <!-- Perbaiki gestur MIUI -->
    <string name="miui_fix_title">Perbaiki gestur MIUI</string>
    <string name="miui_fix_sub">Jika gestur layar penuh berubah jadi tombol</string>
    <string name="miui_fix_problem_title">Masalahnya</string>
    <string name="miui_fix_problem">Di beberapa versi MIUI, gestur layar penuh otomatis dimatikan (atau kembali ke tombol navigasi) ketika launcher pihak ketiga seperti InkLauncher dijadikan default. Perbaikannya adalah mengubah satu pengaturan sistem: force_fsg_nav_bar = 1, yang memaksa MIUI tetap memakai gestur layar penuh.</string>
    <string name="miui_fix_disclaimer">Catatan: ini bergantung pada versi MIUI dan bukan jaminan. Animasi recents mungkin tetap memakai animasi sistem.</string>
    <string name="miui_fix_status">Status</string>
    <string name="miui_fix_current_value">Nilai force_fsg_nav_bar</string>
    <string name="miui_fix_value_unknown">Tidak bisa dibaca (butuh Shizuku)</string>
    <string name="miui_fix_value_on">1 – gestur layar penuh dipaksa aktif</string>
    <string name="miui_fix_value_off">%1$s – tidak dipaksa</string>
